---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Design System Constants */
	:root {
		--font-serif: "Georgia", serif;
		--font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		
		/* Fluid Type Scale */
		--step-0: clamp(0.88rem, 0.83rem + 0.24vw, 1.00rem);
		--step-1: clamp(1.09rem, 1.00rem + 0.47vw, 1.33rem);
		--step-2: clamp(1.37rem, 1.21rem + 0.78vw, 1.78rem);
		--step-3: clamp(1.71rem, 1.45rem + 1.27vw, 2.37rem);
		--step-4: clamp(2.14rem, 1.74rem + 1.98vw, 3.16rem);

		/* Layout Sizing Constants */
		--container-max: 960px;
		--gutter: 1.5rem;
	}

	/* Dynamic System Colour Palette (Responsive Themes) */
	@media (prefers-color-scheme: dark) {
		:root {
			--bg-canvas: #1a1a1a;
			--bg-surface: #222222;
			--text-primary: #ffffff;
			--text-muted: #a0a0a0;
			--border-accent: #333333;
			--action-hover: #ffffff;
			--action-text-hover: #1a1a1a;
		}
	}

	@media (prefers-color-scheme: light) {
		:root {
			--bg-canvas: #fcfcfc;
			--bg-surface: #f4f4f4;
			--text-primary: #1a1a1a;
			--text-muted: #666666;
			--border-accent: #e0e0e0;
			--action-hover: #1a1a1a;
			--action-text-hover: #ffffff;
		}
	}

	/* Structural Resets */
	*, *::before, *::after {
		box-sizing: border-box;
	}

	html {
		font-family: var(--font-serif);
		font-size: 100%;
		background-color: var(--bg-canvas);
		color: var(--text-primary);
		line-height: 1.6;
		scroll-behavior: smooth;
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		padding: 0;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	/* Micro Typography Overrides */
	h1, h2, h3, th {
		font-family: var(--font-sans);
		line-height: 1.2;
		margin-top: 0;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	h1 { font-size: var(--step-4); }
	h2 { font-size: var(--step-3); }
	h3 { font-size: var(--step-2); }

	a {
		color: inherit;
		text-decoration-underline-offset: 3px;
	}

	img, svg {
		display: block;
		max-width: 100%;
		height: auto;
	}

	/* Responsive Structural Utilities */
	.container {
		width: 100%;
		max-width: var(--container-max);
		margin-left: auto;
		margin-right: auto;
		padding-left: var(--gutter);
		padding-right: var(--gutter);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.pipeline-main { padding: 4rem 0; }
  .hero-section { text-align: center; margin-bottom: 6rem; }
  .brand-monogram { display: block; width: 100%; margin-bottom: 1.5rem; text-align: center; color: #127C44; }
  @media (prefers-color-scheme: dark) { .brand-monogram { color: #38b06c; } }
  .tagline { font-size: var(--step-1); color: var(--text-muted); max-width: 55ch; margin: 1rem auto 2.5rem auto; line-height: 1.6; }
  .identity-badge-row { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .badge { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.5rem 1rem; background: var(--bg-surface); border: 1px solid var(--border-accent); border-radius: 4px; }
  
  .hourglass-section, .registry-section, .clinic-section, .coaching-section { margin-bottom: 6rem; }
  .hourglass-section h2, .registry-section h2, .clinic-section h2, .coaching-section h2 { border-left: 2px solid var(--text-primary); padding-left: 1rem; margin-bottom: 3rem; }
  
  .matrix-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .matrix-node { background: var(--bg-surface); border: 1px solid var(--border-accent); padding: 2rem; border-radius: 4px; }
  .active-core { border: 1px dashed var(--text-primary); background: transparent; }
  
  .section-meta { margin-bottom: 3rem; }
  .section-desc { color: var(--text-muted); font-size: var(--step-1); max-width: 65ch; }
  .distortion-cluster { display: flex; flex-direction: column; gap: 1.5rem; }
  
  .inverted-classroom-callout { background: var(--bg-surface); border-left: 3px solid var(--brand-accent); padding: 2rem; margin-bottom: 2.5rem; border-radius: 0 4px 4px 0; }
  .inverted-classroom-callout h3 { margin-top: 0; margin-bottom: 0.5rem; font-size: var(--step-1); }
  .inverted-classroom-callout p { margin: 0; color: var(--text-muted); font-size: var(--step-0); line-height: 1.6; }
  .clinic-timeline-wrapper h3 { font-size: var(--step-1); margin-bottom: 1.5rem; }
  .timeline-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .time-slot { background: var(--bg-surface); border: 1px solid var(--border-accent); padding: 1rem; border-radius: 4px; font-size: var(--step-0); }
  .time-slot strong { color: var(--brand-accent); display: block; font-family: var(--font-sans); margin-bottom: 0.25rem; }
  .clinic-footnote { font-size: var(--step-0); color: var(--text-muted); font-style: italic; }

  .table-responsive { width: 100%; overflow-x: auto; }
  .pricing-table { width: 100%; border-collapse: collapse; text-align: left; font-size: var(--step-0); }
  .pricing-table th, .pricing-table td { padding: 1.25rem; border-bottom: 1px solid var(--border-accent); }
  .pricing-table th { background: var(--bg-surface); color: var(--text-primary); font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em; }
  .pricing-table tr:hover td { background: var(--bg-surface); }

  .pipeline-gateways { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-top: 4rem; border-top: 1px solid var(--border-accent); padding-top: 4rem; }
  .gate-card { background: var(--bg-surface); border: 1px solid var(--border-accent); padding: 2.5rem; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; }
  .highlighted-gate { border-color: var(--text-primary); }
  .gate-card h3 { margin-bottom: 1rem; }
  .gate-card p { color: var(--text-muted); margin-bottom: 2rem; font-size: var(--step-0); }
  .gate-link { font-family: var(--font-sans); font-weight: 600; text-decoration: none; font-size: var(--step-0); }
  .action-btn { display: block; text-align: center; border: 1px solid var(--text-primary); padding: 0.75rem; border-radius: 4px; transition: all 0.2s ease; }
  .action-btn:hover { background: var(--action-hover); color: var(--action-text-hover); }
  .legal-attribution { text-align: center; margin-top: 6rem; font-family: var(--font-sans); font-size: 0.85rem; color: var(--text-muted); }
</style>