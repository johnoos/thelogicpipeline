---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Design System Constants */
	:root {
		--font-serif: "Georgia", serif;
		--font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		
		/* Fluid Type Scale */
		--step-0: clamp(0.88rem, 0.83rem + 0.24vw, 1.00rem);
		--step-1: clamp(1.09rem, 1.00rem + 0.47vw, 1.33rem);
		--step-2: clamp(1.37rem, 1.21rem + 0.78vw, 1.78rem);
		--step-3: clamp(1.71rem, 1.45rem + 1.27vw, 2.37rem);
		--step-4: clamp(2.14rem, 1.74rem + 1.98vw, 3.16rem);

		/* Layout Sizing Constants */
		--container-max: 960px;
		--gutter: 1.5rem;
	}

	/* Dynamic System Colour Palette (Responsive Themes) */
	@media (prefers-color-scheme: dark) {
		:root {
			--bg-canvas: #1a1a1a;
			--bg-surface: #222222;
			--text-primary: #ffffff;
			--text-muted: #a0a0a0;
			--border-accent: #333333;
			--action-hover: #ffffff;
			--action-text-hover: #1a1a1a;
		}
	}

	@media (prefers-color-scheme: light) {
		:root {
			--bg-canvas: #fcfcfc;
			--bg-surface: #f4f4f4;
			--text-primary: #1a1a1a;
			--text-muted: #666666;
			--border-accent: #e0e0e0;
			--action-hover: #1a1a1a;
			--action-text-hover: #ffffff;
		}
	}

	/* Structural Resets */
	*, *::before, *::after {
		box-sizing: border-box;
	}

	html {
		font-family: var(--font-serif);
		font-size: 100%;
		background-color: var(--bg-canvas);
		color: var(--text-primary);
		line-height: 1.6;
		scroll-behavior: smooth;
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		padding: 0;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	/* Micro Typography Overrides */
	h1, h2, h3, th {
		font-family: var(--font-sans);
		line-height: 1.2;
		margin-top: 0;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	h1 { font-size: var(--step-4); }
	h2 { font-size: var(--step-3); }
	h3 { font-size: var(--step-2); }

	a {
		color: inherit;
		text-decoration-underline-offset: 3px;
	}

	img, svg {
		display: block;
		max-width: 100%;
		height: auto;
	}

	/* Responsive Structural Utilities */
	.container {
		width: 100%;
		max-width: var(--container-max);
		margin-left: auto;
		margin-right: auto;
		padding-left: var(--gutter);
		padding-right: var(--gutter);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>