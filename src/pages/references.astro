---
// src/components/references.astro (or wherever it resides in your workspace layout)
import { vaultFiles } from '../data/vault.js'; // Adjust path depth (e.g., '../../data/vault.js') if this file is deep in components

export const prerender = true;

// Keep your standard architectural styling rules intact
const BRAND_ACCENT = "#127C44"; 
---

<div class="references-container">
  <!-- If you have header code text here, keep it intact -->
  
  <ul class="file-list">
    {vaultFiles.map(file => (
      <li class="file-item">
        <!-- 
          The template dynamically couples the flat root asset directory path parameter 
          with your clean lowercase-and-hyphen slugs, dropping the old subfolders completely.
        -->
        <a 
          class="file-link" 
          href={`/assets/${file.slug}`} 
          target="_blank" 
          rel="noopener noreferrer"
        >
          <span class="bullet">&#9632;</span>
          <span class="file-name">{file.name}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Paste this into the <style> tags of BOTH files */
  .file-link,
  .file-link span,
  .file-name {
    color: #4a4a4a !important; /* Forces a solid, readable dark grey */
    text-decoration: none;
    font-size: 1.15rem;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .bullet {
    color: #127C44 !important; /* Keeps the signature hourglass green accent */
    margin-right: 12px;
    font-weight: bold;
  }

  .file-link:hover,
  .file-link:hover span {
    color: #127C44 !important; /* Transitions cleanly to green on mouse hover */
  }
</style>