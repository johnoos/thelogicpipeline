---
// src/components/references.astro (or wherever it resides in your workspace layout)
import { vaultFiles } from '../data/vault.js'; // Adjust path depth (e.g., '../../data/vault.js') if this file is deep in components

export const prerender = true;

// Keep your standard architectural styling rules intact
const BRAND_ACCENT = "#127C44"; 
---

<div class="references-container">
  <!-- If you have header code text here, keep it intact -->
  
  <ul class="file-list">
    {vaultFiles.map(file => (
      <li class="file-item">
        <!-- 
          The template dynamically couples the flat root asset directory path parameter 
          with your clean lowercase-and-hyphen slugs, dropping the old subfolders completely.
        -->
        <a 
          class="file-link" 
          href={`/assets/${file.slug}`} 
          target="_blank" 
          rel="noopener noreferrer"
        >
          <span class="bullet">&#9632;</span>
          <span class="file-name">{file.name}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  /* 1. Target the list container directly to strip standard browser styling */
  .file-list {
    list-style: none !important;      /* Removes the default native round bullets */
    list-style-type: none !important; /* Secondary explicit reinforcement */
    padding: 0;
    margin: 0;
  }

  /* 2. Style properties for the text and items */
  .file-link,
  .file-link span,
  .file-name {
    color: #888888 !important; /* Shifts text to a mid-tone grey for high contrast against green */
    text-decoration: none;
    font-size: 1.15rem;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  /* 3. The manual square marker accent alignment rules */
  .bullet {
    color: #127C44 !important; /* Preserves your signature green look */
    margin-right: 12px;
    font-weight: bold;
  }

  /* 4. Interactive hover transition rules */
  .file-link:hover,
  .file-link:hover span {
    color: #127C44 !important; /* Snaps dynamically to vibrant green on mouse hover */
  }
</style>