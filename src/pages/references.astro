---
import Layout from '../layouts/Layout.astro';

// Matrix mapping every individual file block to its distinct asset path
const referenceGroups = [
  {
    category: "Academic Evaluations & Degrees",
    folder: "academic-evaluations-degrees",
    assets: [
      { name: "PhD Examiner Reports", file: "phd-examiner-reports.pdf", note: "Official dissertation defense board evaluations." },
      { name: "Doctoral Thesis", file: "doctoral-thesis.pdf", note: "PhD baseline manuscript and structural proofs." },
      { name: "Master's Thesis", file: "masters-thesis.pdf", note: "Postgrad exploratory research frameworks." },
      { name: "Honours Thesis", file: "honours-thesis.pdf", note: "Undergraduate structural logic dissertation." },
      { name: "Academic Transcripts", file: "academic-transcripts.pdf", note: "Complete postgrad grading marks and credits." },
      { name: "Graduation Certificates", file: "graduation-certificates.pdf", note: "Formal degree validation credentials." }
    ]
  },
  {
    category: "Professional & Technical Credentials",
    folder: "professional-technical-credentials",
    assets: [
      { name: "Curriculum Vitae", file: "curriculum-vitae.pdf", note: "Comprehensive corporate and academic tracking record." },
      { name: "Enterprise IT Architecture Certifications", file: "enterprise-architect-certifications.pdf", note: "Formal validation of senior IT system engineering credentials." },
      { name: "Publications, Academic And Technical", file: "peer-reviewed-publications.pdf", note: "Journal articles and logic engineering papers." },
      { name: "International Courses", file: "international-courses.pdf", note: "Global advanced method credentials." }
    ]
  }
];
---

<Layout title="Academic Assets & References | The Logic Pipeline">
  <main class="container">
    <header class="page-header">
      <a href="/" class="back-link">← Return to Pipeline Diagnostics</a>
      <h1>Academic Text References</h1>
      <p class="subtitle">Individual source documents, corporate credentials, and formal validation files.</p>
    </header>

    <div class="repository-grid">
      {referenceGroups.map((group) => (
        <section class="asset-group">
          <h2>{group.category}</h2>
          <ul class="asset-list">
            {group.assets.map((asset) => (
              <li class="asset-item">
                <div class="item-meta">
                  <span class="item-title">{asset.name}</span>
                  <span class="item-note">{asset.note}</span>
                </div>
                <a 
                  href={`/assets/${group.folder}/${asset.file}`} 
                  class="download-btn"
                >
                  View Asset
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .page-header {
    margin-bottom: 4rem;
  }
  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-family: var(--font-sans);
    display: inline-block;
    margin-bottom: 1.5rem;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--text-primary);
  }
  h1 {
    font-size: var(--step-4);
    margin: 0 0 0.5rem 0;
  }
  .subtitle {
    font-size: var(--step-1);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }
  .repository-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .asset-group h2 {
    font-size: var(--step-2);
    border-bottom: 1px solid var(--border-accent);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }
  .asset-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .asset-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 4px;
    gap: 2rem;
  }
  .item-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .item-title {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--text-primary);
  }
  .item-note {
    font-size: var(--step-0);
    color: var(--text-muted);
  }
  .download-btn {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--text-primary);
    padding: 0.5rem 1rem;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .download-btn:hover {
    background: var(--action-hover);
    color: var(--action-text-hover);
  }
  @media (max-width: 640px) {
    .asset-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .download-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>