---
import Layout from '../layouts/Layout.astro';

// Static initialization checks during page generation phases
const registrationOpen = true;
---

<Layout title="Cohort Admission Gate | The Logic Pipeline">
  <main class="container py-xl">
    <header class="section-header">
      <a href="/" class="nav-back">← Diagnostics Baseline</a>
      <h1>Weekly Group Clinic Registration</h1>
      <p class="summary-text">Synchronized 4-week structured logic validation tracks. 4-student capacity cap applies.</p>
    </header>

    <section class="form-wrapper">
      {registrationOpen ? (
        <form action="/api/cohort" method="POST" class="native-form">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="John Smith" />
          </div>
          
          <div class="form-group">
            <label for="email">Academic/Corporate Email Address</label>
            <input type="email" id="email" name="email" required placeholder="name@university.edu" />
          </div>

          <button type="submit" class="submit-action">Submit Admission Request</button>
        </form>
      ) : (
        <div class="alert-box">
          <p>Current synchronization track full. Please arrange an exploratory meeting for future allocations.</p>
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .py-xl {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .section-header {
    margin-bottom: 3rem;
  }
  .nav-back {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    color: var(--text-muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1rem;
  }
  .nav-back:hover {
    color: var(--text-primary);
  }
  .summary-text {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 60ch;
  }
  .form-wrapper {
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    padding: 2.5rem;
    border-radius: 4px;
    max-width: 540px;
  }
  .native-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .form-group label {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
  }
  .form-group input {
    font-family: inherit;
    font-size: var(--step-0);
    padding: 0.75rem;
    background: var(--bg-canvas);
    border: 1px solid var(--border-accent);
    color: var(--text-primary);
    border-radius: 4px;
  }
  .form-group input:focus {
    outline: 1px solid var(--text-primary);
  }
  .submit-action {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--text-primary);
    padding: 1rem;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s ease;
    margin-top: 1rem;
  }
  .submit-action:hover {
    background: var(--action-hover);
    color: var(--action-text-hover);
  }
  .alert-box {
    border-left: 3px solid var(--text-muted);
    padding-left: 1rem;
    color: var(--text-muted);
  }
</style>